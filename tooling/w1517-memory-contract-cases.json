{
  "$schema": "w-w1517-memory-contract-cases-1",
  "status": "design-oracle-input-1",
  "machine": "w1517-memory-contract-machine-1",
  "decisions": ["W-1517"],
  "evidenceBoundary": "design-only; no provider-conformant or implementation result",
  "cases": [
    {
      "id": "W1517-current-contract",
      "decisions": ["W-1517"],
      "input": {
        "profile": {
          "dynamicAllocation": ".forbid",
          "automaticStorage": { "kind": ".stack", "maximumFrame": 8192, "maximumCallPath": 16384 }
        },
        "module": {
          "allocation": ".forbidDynamic",
          "storage": { "kind": ".stack", "maximumFrame": 8192 }
        },
        "allocatorPlan": {
          "kind": ".stack",
          "capacity": 8192,
          "alignment": 16,
          "target": "x86_64-unknown-linux-gnu",
          "guardProbing": true,
          "callPathAdmission": true
        },
        "frameBytes": 64,
        "callPathBytes": 128,
        "storageClass": "nativeStack",
        "mlirLowering": "memref.alloca",
        "functionSummary": "inferred"
      },
      "expected": { "status": "accepted" }
    },
    {
      "id": "W1517-none-is-not-placement",
      "decisions": ["W-1517"],
      "input": { "generalAllocator": ".none" },
      "expected": { "status": "accepted", "facts": { "generalAllocator": "absent", "placement": "unknown" } }
    },
    {
      "id": "W1517-none-does-not-prove-stack",
      "decisions": ["W-1517"],
      "input": { "generalAllocator": ".none", "assumedPlacement": "nativeStack" },
      "expected": { "status": "rejected", "code": "noneDoesNotProvePlacement" }
    },
    {
      "id": "W1517-bounded-budget-refund",
      "decisions": ["W-1517"],
      "input": {
        "allocatorPlan": {
          "kind": ".bounded",
          "budget": 1024,
          "liveBytes": 256,
          "requestedBytes": 512,
          "deallocationBytes": 512,
          "backingCompatible": true
        }
      },
      "expected": { "status": "accepted", "facts": { "bounded": { "budget": 1024, "committedBytes": 768, "refundedBytes": 512 } } }
    },
    {
      "id": "W1517-bounded-budget-before-overflow",
      "decisions": ["W-1517"],
      "input": {
        "allocatorPlan": { "kind": ".bounded", "budget": 1024, "liveBytes": 768, "requestedBytes": 257, "backingCompatible": true }
      },
      "expected": { "status": "rejected", "code": "boundedBudgetExceeded" }
    },
    {
      "id": "W1517-bounded-backing-mismatch",
      "decisions": ["W-1517"],
      "input": {
        "allocatorPlan": { "kind": ".bounded", "budget": 1024, "liveBytes": 0, "requestedBytes": 16, "backingCompatible": false }
      },
      "expected": { "status": "rejected", "code": "boundedBackingIncompatible" }
    },
    {
      "id": "W1517-stack-rejects-task-frame",
      "decisions": ["W-1517"],
      "input": {
        "allocatorPlan": {
          "kind": ".stack", "capacity": 1024, "alignment": 16, "target": "x86_64", "guardProbing": true,
          "callPathAdmission": true, "physicalClass": "taskFrame"
        }
      },
      "expected": { "status": "rejected", "code": "stackTaskFrameRejected" }
    },
    {
      "id": "W1517-stack-has-no-fallback",
      "decisions": ["W-1517"],
      "input": {
        "allocatorPlan": {
          "kind": ".stack", "capacity": 1024, "alignment": 16, "target": "x86_64", "guardProbing": true,
          "callPathAdmission": true, "fallback": true
        }
      },
      "expected": { "status": "rejected", "code": "stackFallbackForbidden" }
    },
    {
      "id": "W1517-stack-never-escapes-callee-frame",
      "decisions": ["W-1517"],
      "input": {
        "allocatorPlan": {
          "kind": ".stack", "capacity": 1024, "alignment": 16, "target": "x86_64", "guardProbing": true,
          "callPathAdmission": true
        },
        "escapes": true,
        "returnStorage": "calleeFrame"
      },
      "expected": { "status": "rejected", "code": "calleeFrameEscape" }
    },
    {
      "id": "W1517-strict-unknown-recursion-fails",
      "decisions": ["W-1517"],
      "input": {
        "allocatorPlan": {
          "kind": ".stack", "capacity": 4096, "alignment": 16, "target": "x86_64", "guardProbing": true,
          "callPathAdmission": true
        },
        "recursion": "unknown"
      },
      "expected": { "status": "rejected", "code": "strictSummaryUnknown" }
    },
    {
      "id": "W1517-concurrency-multiplier-is-bounded",
      "decisions": ["W-1517"],
      "input": {
        "allocatorPlan": {
          "kind": ".stack", "capacity": 1024, "alignment": 16, "target": "x86_64", "guardProbing": true,
          "callPathAdmission": true
        },
        "frameBytes": 512,
        "concurrencyCount": 3
      },
      "expected": { "status": "rejected", "code": "concurrencyBoundExceeded" }
    },
    {
      "id": "W1517-explain-unknown-strict",
      "decisions": ["W-1517"],
      "input": { "strict": true, "explainKinds": ["fact", "unknown"] },
      "expected": { "status": "rejected", "code": "explainUnknownInStrict" }
    },
    {
      "id": "W1517-mlir-task-frame-is-not-stack",
      "decisions": ["W-1517"],
      "input": { "storageClass": "taskFrame", "mlirLowering": "coroutine", "strictStack": false },
      "expected": { "status": "accepted", "facts": { "storageClass": "taskFrame" } }
    },
    {
      "id": "W1517-mlir-class-mismatch-fails",
      "decisions": ["W-1517"],
      "input": { "storageClass": "nativeStack", "mlirLowering": "memref.alloc" },
      "expected": { "status": "rejected", "code": "mlirStorageClassMismatch" }
    },
    {
      "id": "W1517-module-cannot-relax-profile",
      "decisions": ["W-1517"],
      "input": {
        "profile": { "dynamicAllocation": ".forbid", "automaticStorage": ".infer" },
        "module": { "allocation": ".allow", "workspaceRelaxed": true }
      },
      "expected": { "status": "rejected", "code": "modulePolicyRelaxation" }
    },
    {
      "id": "W1517-forbid-spelling-is-rejected",
      "decisions": ["W-1517"],
      "input": { "allocationPolicy": ".forbid" },
      "expected": { "status": "rejected", "code": "ambiguousAllocationPolicy" }
    },
    {
      "id": "W1517-function-annotation-is-not-source-contract",
      "decisions": ["W-1517"],
      "input": { "functionAnnotation": { "allocation": ".forbidDynamic" } },
      "expected": { "status": "rejected", "code": "functionAnnotationNotCurrent" }
    },
    {
      "id": "W1517-memory-profile-fields-are-required",
      "decisions": ["W-1517"],
      "input": { "profile": { "dynamicAllocation": ".allow" } },
      "expected": { "status": "rejected", "code": "memoryProfileFieldRequired" }
    },
    {
      "id": "W1517-benchmark-never-promotes-contract",
      "decisions": ["W-1517"],
      "input": { "benchmark": { "timing": true } },
      "expected": { "status": "rejected", "code": "benchmarkClaimForbidden" }
    },
    {
      "id": "W1517-try-handles-admission-only",
      "decisions": ["W-1517"],
      "input": {
        "allocatorPlan": {
          "kind": ".stack", "capacity": 1024, "alignment": 16, "target": "x86_64", "guardProbing": true,
          "callPathAdmission": true
        },
        "dynamicAdmission": true,
        "tryHandlesAdmission": true
      },
      "expected": { "status": "accepted" }
    },
    {
      "id": "W1517-implementation-claim-is-not-oracle",
      "decisions": ["W-1517"],
      "input": { "functionSummary": "provider-conformant" },
      "expected": { "status": "rejected", "code": "implementationClaimForbidden" }
    }
  ]
}

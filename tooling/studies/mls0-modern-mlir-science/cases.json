      "cancellation-and-cleanup",
      "wakeups-and-timers",
      "I-O-integration",
      "provider-selection-and-errors"
    ],
    "zeroRuntimeProfilesAllowed": true,
    "referenceMlirAsyncRuntimeIsDefault": false

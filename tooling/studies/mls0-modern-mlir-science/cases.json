    {
      "id": "sparse",
      "priority": "P0",
      "package": "std.sparse",
      "operations": ["spmv", "spmm", "sparse-contract"],
      "preserve": ["format-levels", "ordering", "duplicates", "zero-semiring", "layout", "ownership", "workspace"],
      "primaryMlir": ["sparse_tensor", "linalg", "scf", "vector", "gpu", "transform"],
      "benchmark": "SuiteSparse-structure-memory-conversion-and-throughput"
    },
    {
      "id": "stencils",
      "priority": "P0",
      "package": "std.grid",
      "operations": ["stencil", "halo-exchange"],
      "preserve": ["offsets", "halo", "boundary", "grid-layout", "time-steps", "synchronization", "communication"],
      "primaryMlir": ["linalg", "affine", "scf", "vector", "gpu", "omp", "transform"],
      "benchmark": "CPU-GPU-distributed-boundary-and-data-movement"
    },
    {
      "id": "random",
      "priority": "P1",
      "package": "std.random",
      "operations": ["generator", "stream", "distribution"],
      "preserve": ["algorithm", "seed-key", "counter-subsequence", "stream-split", "state", "precision", "reproducibility"],
      "primaryMlir": ["arith", "math", "vector", "scf", "gpu"],
      "benchmark": "quality-reproducibility-splitting-and-throughput"
    },
    {
      "id": "sorting",
      "priority": "P1",
      "package": "std.sort",
      "operations": ["sort", "sort-by", "key-value-sort"],
      "preserve": ["comparator-purity", "total-order", "stability", "layout", "workspace", "determinism"],
      "primaryMlir": ["scf", "vector", "gpu", "transform"],
      "benchmark": "distribution-size-stability-memory-and-device"
    },
    {
      "id": "solvers",
      "priority": "P1",
      "package": "std.solver",
      "operations": ["cg", "gmres", "bicgstab", "multigrid", "direct-solve"],
      "preserve": ["operator", "preconditioner", "tolerance", "stopping-criterion", "iteration-limit", "precision", "workspace", "communication"],
      "primaryMlir": ["linalg", "sparse_tensor", "scf", "vector", "gpu", "transform"],
      "benchmark": "HPCG-NAS-and-reference-solver-convergence-cost"
    }
  ],

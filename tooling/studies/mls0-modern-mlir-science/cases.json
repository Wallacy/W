    { "id": "core-structured", "dialects": ["builtin", "index", "func", "scf"], "phase": "verified-structured-lowering", "boundary": "internal-only" },
    { "id": "numeric", "dialects": ["arith", "math", "complex"], "phase": "after-numeric-mode-proof", "boundary": "internal-only" },
    { "id": "science", "dialects": ["tensor", "linalg", "shape", "affine", "vector"], "phase": "high-level-optimization", "boundary": "internal-only" },
    { "id": "physical-memory", "dialects": ["bufferization", "memref"], "phase": "after-ownership-alias-provenance", "boundary": "late-internal-only" },
    { "id": "tasks", "dialects": ["async"], "phase": "after-W-task-verification", "boundary": "readiness-not-scheduler" },
    { "id": "accelerators", "dialects": ["gpu", "spirv", "nvvm", "rocdl", "amdgpu", "nvgpu", "xegpu"], "phase": "after-W-device-and-transfer-proof", "boundary": "provider-required" },
    { "id": "distributed", "dialects": ["mpi", "shard", "omp"], "phase": "after-distributed-contract", "boundary": "deferred-provider-required" },
    { "id": "schedule", "dialects": ["transform"], "phase": "cost-gated-compiler-recipe", "boundary": "never-public-W-semantics" },
    { "id": "terminal", "dialects": ["cf", "llvm"], "phase": "terminal-lowering", "boundary": "target-and-ABI-specific" }
  ],
  "pipeline": [
    "W-source",
    "CST-AST",
    "typed-HIR",
    "W-semantic-IR-and-verification",

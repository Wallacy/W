    {
      "kind": "explain",
      "instruction": "Compare bit-exact canonical value encoding, the exact compare-exchange failure-order matrix, allocation-free fallback with blocksThread/parking facts, owner-table handles, SnapshotCell, and unsafe reclamation receipts."
    },
    {
      "kind": "recall",
      "instruction": "After the controlled delay, reconstruct target progress, generation exhaustion, drop, and callback drain.",
      "minimumDelaySeconds": 1
    },
    {
      "kind": "repair",
      "instruction": "Repair invalid target fallback, generation wrap, reclaim order, and foreign callback drain.",
      "mutations": {
        "canonical-carrier": "Keep Bool/integer/enum bit codes, LSB-first declaration order, zero high bits, and static orders.",
        "current-composition": "Keep existing atomic and snapshot routes with allocation-free fallback facts.",
        "generational-handle": "Retire a slot when generation reaches its maximum.",
        "snapshot-cell": "Keep reads scoped and publish consuming.",
        "unsafe-adapter": "Drain readers and callbacks before drop, reclaim, destroy, or unpin.",
        "rejected-universal": "Keep raw pointer and universal RCU rejected."
      }
    },
    {
      "kind": "change",
      "instruction": "Add a target profile without changing logical value identity or hiding lifetime and cleanup facts."
    }
  ],

      "expect": {
        "surface": "semantic-reject",
        "diagnostic": "W-TYPE-0124",
        "reason": "the first result is optional borrowed, not a borrowed protocol existential",
        "checkerClaim": false
      }
    },
    {
      "id": "TQ-NEG-legacy-reflect-surface",

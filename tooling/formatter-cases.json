      "decisions": ["W-746", "W-747", "W-781"],
      "input": {
        "lines": [
          "fn scan(rows:Rows){scanRows:for ref row in rows{for value in row{if value==0{continue scanRows} if value>31{break scanRows} consume(value)}}}"

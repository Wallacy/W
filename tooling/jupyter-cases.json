        "curve_secretkey": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "fileFacts": { "permissions": "user-only", "remoteAllowed": false, "logSecret": false, "persistSecret": false },
      "policy": { "requireCurve": true },
      "kernelInfo": { "implementation": "W", "implementation_version": "0", "protocol_version": "5.5", "supported_features": [], "language_info": { "name": "w", "version": "0", "mimetype": "text/x-w", "file_extension": ".w" }, "banner": "W kernel" },
      "host": { "sessionId": "w-session-1", "incarnation": 1, "generationId": "opaque:gen0", "executionOrdinal": 0 }
    }
  },
  "cases": [
    {
      "id": "PYN3-J-kernel-info-lifecycle",
      "decisions": ["W-1112", "W-1114"],
      "operations": [
        { "op": "open", "use": "base" },
        { "op": "frame", "request": { "msgId": "ki", "channel": "shell", "msgType": "kernel_info_request" } },
        { "op": "kernelInfoReply" }
      ],
      "expected": { "status": "accepted", "assertions": { "lifecycle": ["busy", "process", "reply", "idle"] } }
    },
    {
      "id": "PYN3-J-baseline-execute",
      "decisions": ["W-1112", "W-1113", "W-1114", "W-1115", "W-1119"],
      "operations": [
        { "op": "open", "use": "base" },
        { "op": "frame", "request": { "msgId": "k1", "channel": "shell", "msgType": "kernel_info_request" } },
        { "op": "frame", "request": { "msgId": "e1", "channel": "shell", "msgType": "execute_request", "content": { "code": "menu()", "silent": false, "store_history": true, "user_expressions": {}, "allow_stdin": false, "stop_on_error": false } } },
        { "op": "execute", "frameMsgId": "e1", "analysis": { "mutation": true, "readOnly": false, "effectFree": false, "pyn2": { "status": "committed", "publication": "committed" }, "outputs": [{ "media": "text/plain", "parentMsgId": "e1" }] } }
      ],
      "expected": { "status": "accepted", "assertions": { "reservedOrdinal": 1, "generationOpaque": true, "reply": "ok", "lifecycle": ["busy", "process", "reply", "outputs", "idle"], "outputs": 1 } }
    },

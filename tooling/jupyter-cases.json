        "ip": "127.0.0.1",
        "signature_scheme": "hmac-sha256",
        "key": "pyn3-case-key",
        "shell_port": 51001, "iopub_port": 51002, "stdin_port": 51003, "control_port": 51004, "hb_port": 51005,

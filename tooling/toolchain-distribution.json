  "runtimeClosureContract": {
    "default": "freestanding",
    "axes": {
      "wrt": {
        "default": "static-reachability-closed",
        "shared": "explicit-exact-provider-and-abi",
        "none": "only-when-no-wrt-operation-is-reachable"

    {
      "id": "posix-rename",
      "url": "https://pubs.opengroup.org/onlinepubs/9799919799/functions/rename.html",
      "claim": "Same-directory rename provides the POSIX replacement boundary."
    },
    {
      "id": "windows-replacefile",
      "url": "https://learn.microsoft.com/en-us/windows/win32/api/winbase/nf-winbase-replacefilea",
      "claim": "ReplaceFile provides the Windows sibling replacement boundary."
    },
    {
      "id": "cargo-workspaces",
      "url": "https://doc.rust-lang.org/cargo/reference/workspaces.html",
      "claim": "Cargo separates workspace membership from lock metadata."
    },
    {
      "id": "cargo-lock",
      "url": "https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html",
      "claim": "Cargo distinguishes manifest intent from resolved lock facts."
    },
    {
      "id": "python-pylock",
      "url": "https://packaging.python.org/en/latest/specifications/pylock-toml/",
      "claim": "Python records a portable lock record for resolved dependencies."
    }
  ],

{
  "name": "tree-sitter-w",
  "version": "0.0.1",
  "description": "Candidate Tree-sitter grammar for the W language",
  "license": "MIT",
  "private": true,
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "queries",
    "src/**"
  ],
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse:reference": "tree-sitter parse --grammar-path . --quiet --stat ../../reference/last-light/*.w",
    "parse:bmd3-byte-scan": "tree-sitter parse --grammar-path . --quiet --stat ../../benchmarks/byte-scan-view/*.w",
    "parse:hlo0": "tree-sitter parse --grammar-path . --quiet --stat ../../compiler/seed-c/fixtures/hlo0-hello.w",
    "parse:platforms": "tree-sitter parse --grammar-path . --quiet --stat ../../reference/last-light/platform/*/*.w",
    "parse:packages": "tree-sitter parse --grammar-path . --quiet --stat ../../reference/last-light/packages/*/*.w",
    "parse:roots": "tree-sitter parse --grammar-path . --quiet --stat ../../reference/last-light/build.w",
    "parse:std": "tree-sitter parse --grammar-path . --quiet --stat ../../std/runtime/*.w ../../std/build/*.w ../../std/io/*.w ../../std/fs/*.w ../../std/process/*.w ../../std/time/*.w ../../std/si/*.w ../../std/iec/*.w ../../std/http/*.w ../../std/database/*.w ../../std/cache/*.w ../../std/url/*.w ../../std/stream/*.w ../../std/sync/*.w ../../std/memory/*.w ../../std/abort/*.w ../../std/blob/*.w ../../std/json/*.w ../../std/net/*.w ../../std/data/*.w ../../std/csv/*.w ../../std/parquet/*.w ../../std/arrow/*.w ../../std/presentation/*.w ../../std/accelerator/*.w ../../std/tensor/*.w ../../std/dlpack/*.w",
    "parse:fixture": "tree-sitter parse --grammar-path . --quiet --stat ../vscode-w/fixtures/*.w",
    "parse:studies": "tree-sitter parse --grammar-path . --quiet --stat ../studies/*/*.w",
    "parse:r1c0": "tree-sitter parse --grammar-path . --quiet --stat ../studies/r1c0-closure/portable.w ../studies/r1c0-closure/native.w",
    "parse:prc0": "tree-sitter parse --grammar-path . --quiet --stat ../studies/prc0-provider-runtime-closure/current.w ../studies/prc0-provider-runtime-closure/rejected.w",
    "parse:asic0": "tree-sitter parse --grammar-path . --quiet --stat ../studies/asic0-evidence-gap-closure/current.w ../studies/asic0-evidence-gap-closure/adversarial.w",
    "parse:pfu0": "tree-sitter parse --grammar-path . --quiet --stat ../studies/pfu0-pre-freeze-usability/current.w ../studies/pfu0-pre-freeze-usability/adversarial.w",
    "parse:aeg0": "tree-sitter parse --grammar-path . --quiet --stat ../studies/aeg0-app-essentials-gate/current.w ../studies/aeg0-app-essentials-gate/adversarial.w",
    "parse:gen2": "tree-sitter parse --grammar-path . --quiet --stat ../studies/gen2-stream-yield/*.w",
    "parse:hrd0": "tree-sitter parse --grammar-path . --quiet --stat ../../reference/last-light/hot_reload_dev_contract.w ../../reference/last-light/hot_reload_dev_local.w ../../reference/last-light/hot_reload_dev_split.w ../studies/hrd0-hot-reload-dev/*.w",
    "parse:syn2-dyn2": "tree-sitter parse --grammar-path . --quiet --stat ../studies/syn2-dyn2-closure/syn2-module-set.w ../studies/syn2-dyn2-closure/dyn2-local.w ../studies/syn2-dyn2-closure/dyn2-split.w ../studies/syn2-dyn2-closure/generation-reference.w",
    "parse:sec0": "tree-sitter parse --grammar-path . --quiet --stat ../studies/sec0-security-model/*.w",
    "parse:cyc1": "tree-sitter parse --grammar-path . --quiet --stat ../studies/cyc1-explicit-cycle-lifecycle/*.w",
    "parse:brx3": "tree-sitter parse --grammar-path . --quiet --stat ../../reference/last-light/borrow_relations_brx3.w ../studies/brx3-borrow-relations/*.w",
    "parse:cyc2": "tree-sitter parse --grammar-path . --quiet --stat ../../reference/last-light/cyc2_liveness.w ../studies/cyc2-conditional-liveness/*.w",
    "parse:borrow-expressivity": "tree-sitter parse --grammar-path . --quiet --stat ../../reference/last-light/borrow_expressivity.w",
    "check:injections": "tree-sitter query --quiet --grammar-path . queries/injections.scm ../../reference/last-light/hardware.w"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.13"
  }
}

      "linux": "mlir-opt",
      "wsl": "mlir-opt",
      "versionArgs": ["--version"]
    },
    "mlirTranslate": {
      "linux": "mlir-translate",
      "wsl": "mlir-translate",
      "versionArgs": ["--version"]
    },
    "llvmConfig": {
      "linux": "llvm-config",
      "wsl": "llvm-config",
      "versionArgs": ["--version"]

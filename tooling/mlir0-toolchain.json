      "versionArgs": ["--version"]
    },
    "llc": {
      "linux": "llc",
      "wsl": "llc",
      "versionArgs": ["--version"]
    },
    "linkDriver": {
      "linux": "/usr/bin/ld",
      "wsl": "/usr/bin/ld",
      "versionArgs": ["--version"]
    }
  },
  "pipeline": [
    {
      "tool": "mlir-opt",
      "args": ["<input.mlir>", "-o", "<verified.mlir>", "--convert-scf-to-cf", "--convert-cf-to-llvm", "--verify-each"]

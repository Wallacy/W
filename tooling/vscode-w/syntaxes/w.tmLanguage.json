{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "W",
  "scopeName": "source.w",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#units" },
    { "include": "#numbers" },
    { "include": "#pipeline-contract" },
    { "include": "#behavior-bodies" },
    { "include": "#keywords" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#members" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.w",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.w",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.w",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.w",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "constant.character.byte.w",
          "match": "b'(?:[ -&(-~]|\\\\(?:x[0-9A-Fa-f]{2}|[\\\\'nrt0]))'"
        },
        {
          "name": "string.quoted.byte.w",
          "match": "b\\\"(?:[\\x20-\\x21\\x23-\\x5b\\x5d-\\x7e]|\\\\(?:x[0-9A-Fa-f]{2}|[\\\\\\\"nrt0]))*\\\""
        },
        {
          "name": "constant.character.scalar.w",
          "match": "'(?:[^'\\\\\\r\\n]|\\\\.)'"
        },
        {
          "name": "string.quoted.raw.triple.w",
          "begin": "(#)\\\"\\\"\\\"",
          "end": "\\\"\\\"\\\"\\1"
        },
        {
          "name": "string.quoted.triple.w",
          "begin": "\\\"\\\"\\\"",
          "end": "\\\"\\\"\\\"",
          "patterns": [{ "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.raw.w",
          "begin": "(#)\\\"",
          "end": "\\\"\\1"
        },
        {
          "name": "string.quoted.double.w",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            { "name": "constant.character.escape.w", "match": "\\\\(?:[\\\"\\\\nrt0]|u\\{[0-9A-Fa-f]+\\})" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "name": "meta.quantity.w",
          "match": "([0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?)(<)([^>\\r\\n]+)(>)",
          "captures": {
            "1": { "name": "constant.numeric.w" },
            "2": { "name": "punctuation.definition.unit.begin.w" },
            "3": { "name": "support.type.unit.w" },
            "4": { "name": "punctuation.definition.unit.end.w" }
          }
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.w",
          "begin": "\\$\\{",
          "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.w" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.w" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#members" },
            { "include": "#constants" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.w",
          "match": "(?<![A-Za-z0-9_])(?:0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?:_[A-Za-z][A-Za-z0-9]*)?|0[bB][01](?:_?[01])*(?:_[A-Za-z][A-Za-z0-9]*)?|0[oO][0-7](?:_?[0-7])*(?:_[A-Za-z][A-Za-z0-9]*)?|(?:[0-9](?:_?[0-9])*)(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?(?:_[A-Za-z][A-Za-z0-9]*)?)(?![A-Za-z0-9_])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "meta.type-query.w",
          "match": "\\b(type|info)(\\s+)(of)\\b(?=\\s*[\\p{L}\\p{N}_\"'#(\\[])",
          "captures": {
            "1": { "name": "keyword.operator.type-query.w" },
            "3": { "name": "keyword.operator.type-query.w" }
          }
        },
        {
          "name": "entity.name.label.w",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:\\s*(?:for|while|repeat|\\{))"
        },
        {
          "name": "keyword.control.w",
          "match": "\\b(?:break|case|catch|commit|continue|defer|deinit|do|else|for|guard|if|in|lock|pipeline|repeat|return|switch|throw|while)\\b"
        },
        {
          "name": "keyword.declaration.w",
          "match": "\\b(?:abi|alias|allocator|behavior|const|deployment|dimension|domain|entry|enum|export|extension|fn|foreign|from|import|let|module|object|package|protocol|service|struct|test|type|unit|var|workspace)\\b"
        },
        {
          "name": "keyword.effect.w",
          "match": "\\b(?:async|await|panic|spawn|static|throws|try|unsafe)\\b"
        },
        {
          "name": "keyword.modifier.storage.w",
          "match": "\\batomic\\b"
        },
        {
          "name": "keyword.other.parameter.w",
          "match": "\\bnamed\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*:)"
        },
        {
          "name": "keyword.other.ownership.w",
          "match": "\\b(?:copy|inout|pin|ref|shared|take|view|weak)\\b"
        },
        {
          "name": "keyword.operator.w",
          "match": "\\b(?:any|as|each|get|init|is|modify|set|some|storage)\\b"
        }
      ]
    },
    "pipeline-contract": {
      "patterns": [
        {
          "name": "meta.pipeline.contract.w",
          "begin": "(\\bpipeline)(\\s*<)",
          "beginCaptures": {
            "1": { "name": "keyword.control.w" },
            "2": { "name": "punctuation.definition.pipeline.contract.begin.w" }
          },
          "end": ">",
          "endCaptures": {
            "0": { "name": "punctuation.definition.pipeline.contract.end.w" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            {
              "name": "keyword.control.contextual.w",
              "match": "\\btransaction(?=\\s*:)"
            }
          ]
        }
      ]
    },
    "behavior-bodies": {
      "patterns": [
        {
          "name": "meta.behavior.body.w",
          "begin": "\\b(behavior)\\s+[A-Za-z_][A-Za-z0-9_]*(?:<[^>\\r\\n]+>)?\\s+for\\s+[^\\{\\r\\n]+\\{",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.w" }
          },
          "end": "^\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            {
              "name": "entity.name.function.hook.w",
              "match": "\\b(?:mut\\s+)?(willSet|didSet|willModify|didModify)(?=\\s*\\()",
              "captures": {
                "1": { "name": "entity.name.function.hook.w" }
              }
            },
            { "include": "#keywords" },
            { "include": "#operators" },
            { "include": "#members" }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(const)\\s+(?!(?:init|fn|mut|async|unsafe)\\b)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.w" },
            "2": { "name": "constant.other.w" }
          }
        },
        {
          "match": "\\b(fn)\\s*(?:<[^>\\r\\n]+>\\s*)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.w" },
            "2": { "name": "entity.name.function.w" }
          }
        },
        {
          "match": "\\b(service)\\s+([a-z_][A-Za-z0-9_]*)(?:<[^>\\r\\n]+>)?\\s*(?=:)",
          "captures": {
            "1": { "name": "keyword.declaration.w" },
            "2": { "name": "variable.other.constant.w" }
          }
        },
        {
          "match": "\\b(module)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.w" },
            "2": { "name": "entity.name.namespace.w" }
          }
        },
        {
          "match": "\\b(allocator)\\s+([a-z_][A-Za-z0-9_]*)\\s*:",
          "captures": {
            "1": { "name": "keyword.declaration.w" },
            "2": { "name": "variable.other.w" }
          }
        },
        {
          "match": "\\b(alias|behavior|dimension|entry|struct|object|enum|extension|protocol|type|unit)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.w" },
            "2": { "name": "entity.name.type.w" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.w",
          "match": "\\b(?:Bool|Void|String|UnicodeScalar|Error|Never|Type|Int|UInt|Float|Double|i(?:8|16|32|64|128|size)|u(?:8|16|32|64|128|size)|f(?:16|32|64))\\b"
        },
        {
          "name": "entity.name.type.w",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "^\\s*(?:export\\s+)?(?:var\\s+)?([a-z_][A-Za-z0-9_]*)\\s*:(?=[^\\r\\n{}=]+\\{\\s*$)",
          "captures": {
            "1": { "name": "variable.other.member.w" }
          }
        },
        {
          "name": "variable.other.member.w",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.w",
          "match": "\\b(?:true|false|self)\\b|\\.(?:none|some|success|error|canceled)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.w",
          "match": ">\\.\\.<|>\\.\\.|\\?\\.|\\?\\?|\\.\\.<|\\.\\.\\.|=>|\\|>|(?<![\"#])#(?!#*\")|\\*\\*=|<<=|>>=|&=|\\^=|\\|=|==|!=|<=|>=|&&|\\|\\||<<|>>|\\+=|-=|\\*=|/=|%=|[+*/%@=!<>~&^|?-]"
        }
      ]
    }
  }
}

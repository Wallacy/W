{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "W",
  "scopeName": "source.w",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#units" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#members" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.w",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.w",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.w",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.w",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "constant.character.byte.w",
          "match": "b'(?:[ -&(-~]|\\\\(?:x[0-9A-Fa-f]{2}|[\\\\'nrt0]))'"
        },
        {
          "name": "constant.character.scalar.w",
          "match": "'(?:[^'\\\\\\r\\n]|\\\\.)'"
        },
        {
          "name": "string.quoted.triple.w",
          "begin": "\\\"\\\"\\\"",
          "end": "\\\"\\\"\\\"",
          "patterns": [{ "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.raw.w",
          "begin": "(#+)\\\"",
          "end": "\\\"\\1"
        },
        {
          "name": "string.quoted.double.w",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            { "name": "constant.character.escape.w", "match": "\\\\(?:[\\\"\\\\nrt0]|u\\{[0-9A-Fa-f]+\\})" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "name": "meta.quantity.w",
          "match": "(-?[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?)(<)([^>\\r\\n]+)(>)",
          "captures": {
            "1": { "name": "constant.numeric.w" },
            "2": { "name": "punctuation.definition.unit.begin.w" },
            "3": { "name": "support.type.unit.w" },
            "4": { "name": "punctuation.definition.unit.end.w" }
          }
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.w",
          "begin": "\\$\\{",
          "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.w" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.w" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#members" },
            { "include": "#constants" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.w",
          "match": "(?<![A-Za-z0-9_])(?:0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?:_[A-Za-z][A-Za-z0-9_]*)?|0[bB][01](?:_?[01])*(?:_[A-Za-z][A-Za-z0-9_]*)?|(?:[0-9](?:_?[0-9])*)(?:\\.(?:[0-9](?:_?[0-9])*)?)?(?:_[A-Za-z][A-Za-z0-9_]*)?)(?![A-Za-z0-9_])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.w",
          "match": "\\b(?:break|case|catch|continue|defer|deinit|do|else|for|guard|if|in|return|switch|throw|while)\\b"
        },
        {
          "name": "keyword.declaration.w",
          "match": "\\b(?:alias|behavior|const|dimension|entry|enum|export|extension|fn|foreign|from|import|let|object|package|protocol|service|struct|test|type|unit|var)\\b"
        },
        {
          "name": "keyword.effect.w",
          "match": "\\b(?:async|atomic|await|panic|spawn|static|throws|try|unsafe)\\b"
        },
        {
          "name": "keyword.other.ownership.w",
          "match": "\\b(?:capture|copy|inout|ref|shared|take|weak)\\b"
        },
        {
          "name": "keyword.operator.w",
          "match": "\\b(?:any|as|get|init|is|modify|set|some|storage)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(alias|behavior|dimension|entry|fn|struct|object|enum|extension|protocol|type|unit)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.w" },
            "2": { "name": "entity.name.type.w" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.w",
          "match": "\\b(?:Bool|Void|String|UnicodeScalar|Error|Never|Type|Int|UInt|Float|Double|i(?:8|16|32|64|128|size)|u(?:8|16|32|64|128|size)|f(?:16|32|64))\\b"
        },
        {
          "name": "entity.name.type.w",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "^\\s*(?:(?:export|package)\\s+)?(?:var\\s+)?([a-z_][A-Za-z0-9_]*)\\s*:(?=[^\\r\\n{}=]+\\{\\s*$)",
          "captures": {
            "1": { "name": "variable.other.member.w" }
          }
        },
        {
          "name": "variable.other.member.w",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.w",
          "match": "\\b(?:true|false|self)\\b|\\.(?:none|some|ok|error)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.w",
          "match": ">\\.\\.<|>\\.\\.|\\?\\.|\\?\\?|\\.\\.<|\\.\\.\\.|=>|==|!=|<=|>=|&&|\\|\\||<<|>>|\\+=|-=|\\*=|/=|%=|[+*/%@=!<>~&^|?-]"
        }
      ]
    }
  }
}

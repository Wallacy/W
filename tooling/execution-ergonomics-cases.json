    },
    {
      "id": "EE-POS-spawn-optional-domain",
      "kind": "positive",
      "source": "spawn<.compute> let a = f()\nspawn<domain: .compute> let b = f()",
      "expect": { "sameOptionalDomainForm": true }
    },
    {

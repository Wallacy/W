    {
      "id": "EE-POS-doc-example",
      "kind": "positive",
      "source": "/// @example\n/// call: clamp(2, to: 0...3)\n/// result: 2\nfn clamp(value: Int, to range: Range): Int { return value }",
      "expect": { "terminal": "result", "hermetic": true, "releasePayload": false }
    },

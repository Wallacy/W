      "source": "/**\n * @example\n * call: first()\n * result: 1\n */\nfn first(): Int { return 1 }\n/**\n * @example\n * call: second()\n * result: 2\n */\nfn second(): Int { return 2 }",
      "expect": { "terminal": "result", "exampleCount": 2, "hermetic": true, "releasePayload": false }
    },
    {
      "id": "EE-NEG-doc-example-duplicate-terminal",
      "kind": "negative",
      "source": "/** @example\n * call: clamp(2)\n * result: 2\n * error: RangeError\n */\nfn clamp(value: Int): Int { return value }",
      "expect": { "diagnostic": "W-DOC-0003" }

    {
      "id": "EE-POS-barrier-read-write-read",
      "kind": "positive",
      "source": "fn summarize(state: ref Menu): u64 { return state.revision }\nfn replace(state: inout Menu, revision: u64): u64 { state.revision = revision; return revision }\nspawn<.catalog> let before = summarize(ref menu)\nspawn<.catalog, .barrier> let update = replace(inout menu, revision: next)\nspawn<.catalog> let after = summarize(ref menu)",
      "input": { "domainCapabilities": { ".catalog": ["concurrent", "barrierDispatch"] } },
      "expect": {
        "domain": ".catalog",
        "dispatchMode": ".barrier",
        "scheduling": "exclusive-barrier",
        "barrierSupport": "bound",
        "place": "menu",
        "loanClosed": true,
        "barrierEdges": ["0.complete->1.start", "1.complete->2.start"]
      }
    },

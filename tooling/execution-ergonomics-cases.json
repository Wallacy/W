{
  "$schema": "w-execution-ergonomics-cases-2",
  "status": "design-oracle-input",
  "cases": [
    {
      "id": "EE-POS-generic-optional-labels",
      "kind": "positive",
      "source": "struct OvenSession<_ state: OvenSessionState> {}\nlet a = OvenSession<.ready>.state\nlet b = OvenSession<state: .ready>.state",
      "expect": { "genericPolicy": "optional(name)", "genericIdentity": "same" }
    },
    {
      "id": "EE-POS-callable-optional-label",
      "kind": "positive",
      "source": "fn open(_ name: String) {}\nopen(\"oven\")\nopen(name: \"oven\")",
      "expect": { "callableName": "open", "callablePolicy": "optional(name)", "forms": ["positional", "name:"] }
    },
    {
      "id": "EE-POS-callable-external-internal-label",
      "kind": "positive",
      "source": "fn route(to range: Range, during duration: Duration) {}\nroute(to: 1, during: 2)",
      "expect": { "callableName": "route", "callableExternal": "to", "callableInternal": "range", "parameterIndex": 0 }
    },
    {
      "id": "EE-NEG-callable-unknown-external-label",
      "kind": "negative",
      "source": "fn route(to range: Range, during duration: Duration) {}\nroute(from: 1, during: 2)",
      "expect": { "diagnostic": "W-LABEL-0005", "callableName": "route" }
    },
    {
      "id": "EE-POS-label-shapes-disjoint",
      "kind": "positive",
      "source": "fn serve(_ value: Value) {}\nfn serve(_ value: Value, mode: Mode) {}",
      "expect": { "callableName": "serve", "callShapes": ["positional", "value:"] }
    },
    {
      "id": "EE-NEG-label-collision",
      "kind": "negative",
      "source": "fn open(_ name) {}\nfn open(name) {}",
      "expect": { "diagnostic": "W-LABEL-0004" }
    },
    {
      "id": "EE-NEG-label-unknown",
      "kind": "negative",
      "source": "fn open(_ name) {}\nopen(other: 1)",
      "expect": { "diagnostic": "W-LABEL-0005", "callableName": "open" }
    },
    {
      "id": "EE-NEG-label-duplicate",
      "kind": "negative",
      "source": "fn open(_ name) {}\nopen(name: 1, name: 2)",
      "expect": { "diagnostic": "W-LABEL-0006", "callableName": "open" }
    },
    {
      "id": "EE-NEG-generic-label-unknown",
      "kind": "negative",
      "source": "struct OvenSession<_ state: State> {}\nlet value = OvenSession<other: .ready>",
      "expect": { "diagnostic": "W-LABEL-0005" }
    },
    {
      "id": "EE-NEG-generic-label-duplicate",
      "kind": "negative",
      "source": "struct Pair<_ left: Int, _ right: Int> {}\nlet value = Pair<left: 1, left: 2>",
      "expect": { "diagnostic": "W-LABEL-0006" }
    },
    {
      "id": "EE-POS-direct-never",
      "kind": "positive",
      "source": "fn sync(value: Int): Int { return value }\nlet result = sync(1)",
      "expect": { "callee": "sync", "suspension": "never", "callForm": "direct" }
    },
    {
      "id": "EE-POS-await-may",
      "kind": "positive",
      "source": "fn load(): Value { await Task.yield(); return value }\nlet result = await load()",
      "expect": { "callee": "load", "suspension": "may", "callForm": "await", "sourceSpelling": "inferred" }
    },
    {
      "id": "EE-POS-async-let-sync",
      "kind": "positive",
      "source": "fn sync(value): Value { return value }\nasync let child = sync(input)\nlet value = await child",
      "expect": { "childForm": "async let", "childAccepts": ["never", "may"] }
    },
    {
      "id": "EE-POS-spawn-may",
      "kind": "positive",
      "source": "fn work(value): Value { await Task.yield(); return value }\nspawn<.compute> let child = work(input)\nlet value = await child",
      "expect": { "childForm": "spawn", "childAccepts": ["never", "may"] }
    },
    {
      "id": "EE-POS-scc-inference",
      "kind": "positive",
      "source": "fn even(n) { if n == 0 { return true }; return await odd(n - 1) }\nfn odd(n) { await Task.yield(); return if n == 0 { false } else { await even(n - 1) } }",
      "expect": { "sccSuspension": "may", "members": ["even", "odd"] }
    },
    {
      "id": "EE-INFO-public-widening",
      "kind": "information",
      "source": "export fn publicCall(value): Value { await Task.yield(); return value }",
      "input": { "publicContract": { "previous": "never", "current": "may", "exported": true } },
      "expect": { "sourceBreaking": true, "widening": true }
    },
    {
      "id": "EE-POS-protocol-explicit-suspension",
      "kind": "positive",
      "source": "protocol Loader { async fn load(): Value }",
      "expect": { "declaration": "load", "suspension": "may", "sourceSpelling": "explicit" }
    },
    {
      "id": "EE-NEG-bare-may-suspend",
      "kind": "negative",
      "source": "async fn load(): Value { return value }\nfn caller(): Value { return load() }",
      "expect": { "callee": "load", "diagnostic": "W-SUSPEND-0001" }
    },
    {
      "id": "EE-INFO-await-never",
      "kind": "information",
      "source": "fn value(): Value { return 1 }\nfn caller(): Value { return await value() }",
      "expect": { "callee": "value", "diagnostic": "W-SUSPEND-0002", "removable": true }
    },
    {
      "id": "EE-NEG-blocking-sync",
      "kind": "negative",
      "source": "fn caller(): Value { return blockingWait(task) }",
      "expect": { "diagnostic": "W-SUSPEND-0003", "fix": null }
    },
    {
      "id": "EE-POS-child-staging",
      "kind": "positive",
      "source": "async let child = work(prepare(input))\nspawn<domain: .compute> let parallel = work(capture)",
      "expect": { "evaluation": ["callee", "arguments", "captures", "reserve", "publish"], "child": "structured" }
    },
    {
      "id": "EE-NEG-spawn-serial",
      "kind": "negative",
      "source": "module kitchen<domains: [.serial(.thermal)]>\nspawn<.thermal> let work = f()",

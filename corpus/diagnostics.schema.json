{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w-lang.invalid/schemas/diagnostics-1.json",
  "title": "W diagnostic contract",
  "type": "object",
  "required": ["schema", "case", "source", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "w.diagnostics/1" },
    "case": { "type": "string" },
    "source": { "type": "string" },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "primary", "parser"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^W-SYN-[0-9]{4}$" },
          "severity": { "const": "error" },
          "message": { "type": "string", "minLength": 1 },
          "primary": { "$ref": "#/$defs/span" },
          "parser": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["ERROR", "MISSING"] },
              "expectedNode": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["row", "column", "byte"],
      "additionalProperties": false,
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "byte": { "type": "integer", "minimum": 0 }
      }
    },
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/point" },
        "end": { "$ref": "#/$defs/point" }
      }
    }
  }
}

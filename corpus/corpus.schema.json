{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w-lang.invalid/schemas/corpus-1.json",
  "title": "W contract corpus manifest",
  "type": "object",
  "required": ["schema", "edition", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "w.corpus/1" },
    "edition": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "source", "snapshot", "polarity", "classification", "family", "rules", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "source": { "type": "string", "pattern": "^(positive|negative)/.+\\.w$" },
        "snapshot": { "type": "string", "pattern": "^snapshots/.+\\.cst$" },
        "polarity": { "enum": ["positive", "negative"] },
        "classification": { "enum": ["executable", "frontend-only"] },
        "family": { "type": "string", "minLength": 1 },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "expect": {
          "oneOf": [
            {
              "type": "object",
              "required": ["parse", "observable"],
              "additionalProperties": false,
              "properties": {
                "parse": { "const": "success" },
                "observable": {
                  "type": "object",
                  "required": ["kind", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "enum": ["stdout", "cst"] },
                    "value": { "type": "string" }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["parse", "diagnostic"],
              "additionalProperties": false,
              "properties": {
                "parse": { "const": "failure" },
                "diagnostic": {
                  "type": "object",
                  "required": ["code", "message"],
                  "additionalProperties": false,
                  "properties": {
                    "code": { "type": "string", "pattern": "^W-SYN-[0-9]{4}$" },
                    "message": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}

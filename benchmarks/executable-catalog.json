  "resultContract": {
    "schema": "w-executable-benchmark-result/3",
    "status": "contract-only",
    "recordsPath": "benchmarks/history/executables",
    "requiredIdentity": ["workloadId", "language", "platformTarget", "artifactTarget", "profile", "toolchain", "host", "recipe", "recipeClass", "recipeDigest", "equivalenceKey"],
      "provenance": ["sourceDigest", "artifactDigest", "recipeDigest", "toolchainDigest", "runnerDigest", "catalogDigest", "commit", "observedAt"],
    "sampling": {
      "warmupMinimum": 1,
      "rawMinimum": 9,
      "rawParity": "odd",
      "sampleFields": ["wallNs", "cpuUserUs", "cpuSystemUs", "cpuTotalUs", "peakRssBytes"],
      "cpuUnits": "microseconds",
      "zeroCpuDisclosure": "OS/process CPU counters are microsecond resolution; zero-valued samples remain valid and do not imply nanosecond precision."
    },
    "protocolFields": ["warmupMinimum", "rawMinimum", "rawParity", "arithmeticMeanRounding", "stopRule", "wallClock", "processIsolation", "order", "resourceScope", "knownNoiseControls", "unknownNoiseControls", "directProcessDisclosure"],
    "environmentFields": ["os", "kernel", "cpuModel", "logicalCores", "ramBytes"],
    "artifact": "Artifact digest and sizeBytes are correctness-build facts, not repeated samples.",
    "metrics": ["compile-latency", "run-wall-time", "cpu-user-time", "cpu-system-time", "cpu-time", "peak-working-set", "artifact-size", "exit-code", "stdout", "stderr"],
    "immutability": "A recorded result is append-only; raw samples, derived summaries, identity, correctness and provenance are never overwritten."
  },
  "bestKnownContract": {
    "schema": "w-executable-benchmark-best/3",
    "status": "defined",
    "path": "benchmarks/executable-best-known.json",
    "derivation": "Derived only from validated immutable executable-result records and their recomputed workload equivalence keys.",
    "optimizableMetrics": ["compile-latency", "run-wall-time", "cpu-time", "peak-working-set", "artifact-size"],
    "forbiddenMetrics": ["exit-code", "stdout", "stderr"],
    "rule": "Best-known records contain only the minimum validated median for sampled metrics or one correctness artifact size within one exact workload, platform target, artifact target, release profile, recipe class, toolchain and host identity; correctness outputs never rank."
  }
}

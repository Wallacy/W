{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wbench/1",
  "title": "WBench/1",
  "description": "Schema for W benchmark protocols and compiler lifecycle measurements.",
  "oneOf": [
    { "$ref": "#/$defs/program" },
    { "$ref": "#/$defs/workloadManifest" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "u64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0][0-9]|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "track", "primary", "regression", "description"],
      "properties": {
        "id": { "enum": ["learner", "idiomatic", "frontier"] },
        "track": { "const": "language" },
        "primary": { "type": "boolean" },
        "regression": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "disclosures": {
          "type": "object", "additionalProperties": false,
          "required": [],
          "properties": {
            "unsafe": { "type": "string", "minLength": 1 },
            "ffi": { "type": "string", "minLength": 1 },
            "targetSpecialization": { "type": "string", "minLength": 1 },
            "manualLayout": { "type": "string", "minLength": 1 },
            "algorithm": { "type": "string", "minLength": 1 },
            "legibility": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "implementation", "dependencies", "outputs", "adversarialCases", "stopCondition"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "status": { "enum": ["completed", "ready", "blocked"] },
        "implementation": { "enum": ["complete", "partial", "pending", "blocked"] },
        "blockedBy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "adversarialCases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "stopCondition": { "type": "string", "minLength": 1 }
      }
    },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "requirements"],
      "properties": {
        "id": { "enum": ["equivalent", "open"] },
        "description": { "type": "string", "minLength": 1 },
        "requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "baselinePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["defaultIndependent", "exception", "gameRole"],
      "properties": {
        "defaultIndependent": { "const": ["c-clang", "rust"] },
        "exception": { "type": "string", "minLength": 1 },
        "gameRole": { "const": "exploratory-never-authority" }
      }
    },
    "program": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "schema", "kind", "id", "status", "backend", "profiles", "lanes", "baselinePolicy", "tasks"],
      "properties": {
        "$schema": { "const": "./wbench-1.schema.json" },
        "schema": { "const": "wbench/1" },
        "kind": { "const": "program" },
        "id": { "const": "bmd1" },
        "status": { "const": "ready" },
        "backend": {
          "type": "object", "additionalProperties": false,
          "required": ["benchmarkRunnerAvailable", "compilerLifecycleResultsAllowed", "languageResultsAllowed", "productRuntimeResultsAllowed", "note"],
          "properties": {
            "benchmarkRunnerAvailable": { "const": true },
            "compilerLifecycleResultsAllowed": { "const": true },
            "languageResultsAllowed": { "const": false },
            "productRuntimeResultsAllowed": { "const": false },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "profiles": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/profile" } },
        "lanes": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/lane" } },
        "baselinePolicy": { "$ref": "#/$defs/baselinePolicy" },
        "tasks": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/task" } }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "symbol", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "identityDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "descriptorIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "operation", "arguments"],
      "properties": {
        "tool": { "const": "w" },
        "operation": { "const": "check" },
        "arguments": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "resultIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "graph", "input", "command"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "graph": { "$ref": "#/$defs/descriptorIdentity" },
        "input": { "$ref": "#/$defs/descriptorIdentity" },
        "command": { "$ref": "#/$defs/command" }
      }
    },
    "matrixPoint": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario", "stage", "status", "blockedBy"],
      "properties": {
        "scenario": { "enum": ["clean", "no-op", "edit"] },
        "stage": { "enum": ["check-end-to-end", "source", "lex", "parse", "semantic", "hir", "lowering", "codegen", "link"] },
        "status": { "enum": ["ready", "blocked"] },
        "blockedBy": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "matrix": {
      "type": "object", "additionalProperties": false,
      "required": ["scenarios", "stages", "points"],
      "properties": {
        "scenarios": { "type": "array", "const": ["clean", "no-op", "edit"] },
        "stages": { "type": "array", "const": ["check-end-to-end", "source", "lex", "parse", "semantic", "hir", "lowering", "codegen", "link"] },
        "points": { "type": "array", "minItems": 27, "maxItems": 27, "items": { "$ref": "#/$defs/matrixPoint" } }
      }
    },
    "workloadManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "schema", "kind", "id", "status", "track", "lane", "benchmarkDisposition", "backend", "identity", "command", "languageProfiles", "matrix", "oracle", "measurementPolicy", "baselinePolicy", "outputs"],
      "properties": {
        "$schema": { "const": "./wbench-1.schema.json" },
        "schema": { "const": "wbench/1" },
        "kind": { "const": "workload-manifest" },
        "id": { "const": "bmd1-seed-check-lifecycle" },
        "status": { "const": "ready" },
        "track": { "const": "compiler-lifecycle" },
        "lane": { "enum": ["equivalent", "open"] },
        "benchmarkDisposition": { "const": "compiler-lifecycle" },
        "backend": {
          "type": "object", "additionalProperties": false,
          "required": ["benchmarkRunnerAvailable", "frontendAvailable", "nativeBackendAvailable", "runtimeAvailable", "compilerLifecycleResultsAllowed", "languageResultsAllowed", "productRuntimeResultsAllowed"],
          "properties": {
            "benchmarkRunnerAvailable": { "const": true },
            "frontendAvailable": { "const": true },
            "nativeBackendAvailable": { "const": false },
            "runtimeAvailable": { "const": false },
            "compilerLifecycleResultsAllowed": { "const": true },
            "languageResultsAllowed": { "const": false },
            "productRuntimeResultsAllowed": { "const": false }
          }
        },
        "identity": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "graph", "input"],
          "properties": {
            "source": { "$ref": "#/$defs/source" },
            "graph": { "$ref": "#/$defs/descriptorIdentity" },
            "input": { "$ref": "#/$defs/descriptorIdentity" }
          }
        },
        "command": { "$ref": "#/$defs/command" },
        "languageProfiles": {
          "type": "object", "additionalProperties": false,
          "required": ["applicability", "reason"],
          "properties": {
            "applicability": { "const": "not-applicable" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "matrix": { "$ref": "#/$defs/matrix" },
        "oracle": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "requiredBeforeSamples", "runtime"],
          "properties": {
            "kind": { "const": "host-structural" },
            "requiredBeforeSamples": { "const": true },
            "runtime": { "const": "unavailable" }
          }
        },
        "measurementPolicy": {
          "type": "object", "additionalProperties": false,
          "required": ["correctnessFirst", "rawSamples", "warmup", "stopRule", "clock", "order", "comparisonOrder", "environmentFields", "metrics", "semanticDeviations", "safetyDisclosures"],
          "properties": {
            "correctnessFirst": { "const": true },
            "rawSamples": { "const": "required-after-oracle" },
            "warmup": { "const": "record-before-samples" },
            "stopRule": { "const": "fixed-count" },
            "clock": { "const": "monotonic-wall-ns" },
            "order": { "const": "single-series" },
            "comparisonOrder": { "const": "randomized-interleaved" },
            "environmentFields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "metrics": { "type": "array", "minItems": 1, "items": { "const": "latency-ns" } },
            "semanticDeviations": { "const": "record-all" },
            "safetyDisclosures": { "const": "record-all" }
          }
        },
        "baselinePolicy": {
          "type": "object", "additionalProperties": false,
          "required": ["primary", "independent", "role", "exceptionReason", "recipe"],
          "properties": {
            "primary": { "const": "historical-w" },
            "independent": { "const": ["c-clang", "rust"] },
            "role": { "const": "contextual-not-ranking" },
            "exceptionReason": { "type": ["null", "string"] },
            "recipe": { "const": "equivalent" }
          }
        },
        "outputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "resultSample": {
      "type": "object", "additionalProperties": false,
      "required": ["ns"],
      "properties": { "ns": { "$ref": "#/$defs/u64" } }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "schema", "kind", "id", "status", "quality", "claim", "workload", "identity", "comparison", "oracle", "samples", "environment", "provenance", "metrics", "summary", "semanticDeviations", "disclosures"],
      "properties": {
        "$schema": { "const": "./wbench-1.schema.json" },
        "schema": { "const": "wbench/1" },
        "kind": { "const": "result" },
        "id": { "type": "string", "minLength": 1 },
        "status": { "const": "recorded" },
        "quality": { "const": "exploratory" },
        "claim": { "const": "measurement-only" },
        "workload": {
          "type": "object", "additionalProperties": false,
          "required": ["manifestDigest", "track", "lane", "scenario", "stage", "subject", "profile"],
          "properties": {
            "manifestDigest": { "$ref": "#/$defs/digest" },
            "track": { "const": "compiler-lifecycle" },
            "lane": { "enum": ["equivalent", "open"] },
            "scenario": { "enum": ["clean", "no-op", "edit"] },
            "stage": { "enum": ["check-end-to-end", "source", "lex", "parse", "semantic", "hir", "lowering", "codegen", "link"] },
            "subject": { "type": "string", "minLength": 1 },
            "profile": { "const": null }
          }
        },
        "identity": { "$ref": "#/$defs/resultIdentity" },
        "comparison": { "const": null },
        "oracle": {
          "type": "object", "additionalProperties": false,
          "required": ["validationDigest", "complete", "beforeSamples"],
          "properties": {
            "validationDigest": { "$ref": "#/$defs/digest" },
            "complete": { "const": true },
            "beforeSamples": { "const": true }
          }
        },
        "samples": {
          "type": "object", "additionalProperties": false,
          "required": ["raw", "warmup", "stopRule", "clock", "order"],
          "properties": {
            "raw": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/resultSample" } },
            "warmup": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resultSample" } },
            "stopRule": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "count"],
              "properties": {
                "kind": { "const": "fixed-count" },
                "count": { "type": "integer", "minimum": 9 }
              }
            },
            "clock": { "const": "monotonic-wall-ns" },
            "order": { "const": "single-series" }
          }
        },
        "environment": {
          "type": "object", "additionalProperties": false,
          "required": ["hardware", "kernel", "target", "provider", "toolchain", "flags", "noiseControls"],
          "properties": {
            "hardware": { "type": "string", "minLength": 1 },
            "kernel": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "provider": { "type": "string", "minLength": 1 },
            "toolchain": { "type": "string", "minLength": 1 },
            "flags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "noiseControls": {
              "type": "object", "additionalProperties": false,
              "required": ["known", "unknown"],
              "properties": {
                "known": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "unknown": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceDigest", "artifactDigest", "inputDigest", "recipeDigest", "runnerDigest", "toolchainDigest"],
          "properties": {
            "sourceDigest": { "$ref": "#/$defs/digest" },
            "artifactDigest": { "$ref": "#/$defs/digest" },
            "inputDigest": { "$ref": "#/$defs/digest" },
            "recipeDigest": { "$ref": "#/$defs/digest" },
            "runnerDigest": { "$ref": "#/$defs/digest" },
            "toolchainDigest": { "$ref": "#/$defs/digest" }
          }
        },
        "metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["latency"],
          "properties": {
            "latency": {
              "type": "object", "additionalProperties": false,
              "required": ["unit", "minimumNs", "medianNs", "maximumNs", "madNs", "derivedFromRawSamples"],
              "properties": {
                "unit": { "const": "ns" },
                "minimumNs": { "$ref": "#/$defs/u64" },
                "medianNs": { "$ref": "#/$defs/u64" },
                "maximumNs": { "$ref": "#/$defs/u64" },
                "madNs": { "$ref": "#/$defs/u64" },
                "derivedFromRawSamples": { "const": true }
              }
            }
          }
        },
        "summary": {
          "type": "object", "additionalProperties": false,
          "required": ["sampleCount", "warmupCount", "derivedFromRawSamples"],
          "properties": {
            "sampleCount": { "type": "integer", "minimum": 9 },
            "warmupCount": { "type": "integer", "minimum": 1 },
            "derivedFromRawSamples": { "const": true }
          }
        },
        "semanticDeviations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "disclosures": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}

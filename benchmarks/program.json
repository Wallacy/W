{
  "$schema": "./wbench-1.schema.json",
  "schema": "wbench/1",
  "kind": "program",
  "id": "bmd1",
  "status": "ready",
  "backend": {
    "benchmarkRunnerAvailable": true,
    "compilerLifecycleResultsAllowed": true,
    "languageResultsAllowed": false,
    "productRuntimeResultsAllowed": false,
    "note": "BMD1 records exploratory compiler-lifecycle measurements for the source-backed clean check-end-to-end point. Language and product-runtime results remain disabled."
  },
  "profiles": [
    {
      "id": "learner",
      "track": "language",
      "primary": false,
      "regression": false,
      "description": "Correct plausible code from a learner who transfers patterns from another language and underuses W."
    },
    {
      "id": "idiomatic",
      "track": "language",
      "primary": true,
      "regression": true,
      "description": "The recommended production form. This profile is the primary and regression profile."
    },
    {
      "id": "frontier",
      "track": "language",
      "primary": false,
      "regression": false,
      "description": "The declared performance ceiling. Legibility can be lower when disclosures are explicit.",
      "disclosures": {
        "unsafe": "Declare each unsafe boundary and its restored invariant.",
        "ffi": "Declare each foreign call, ABI, ownership and provider requirement.",
        "targetSpecialization": "Declare target, feature set and fallback scope.",
        "manualLayout": "Declare offsets, alignment, representation and boundary.",
        "algorithm": "Declare algorithm and representation changes.",
        "legibility": "Declare each material legibility sacrifice."
      }
    }
  ],
  "lanes": [
    {
      "id": "equivalent",
      "description": "Compare equivalent workloads only.",
      "requirements": [
        "same algorithm",
        "same representation",
        "same validation",
        "same numeric contract",
        "same input"
      ]
    },
    {
      "id": "open",
      "description": "Allow a better algorithm, but do not use the result to measure compiler quality.",
      "requirements": [
        "record algorithm and representation changes",
        "record semantic deviations",
        "keep correctness oracle before samples"
      ]
    }
  ],
  "baselinePolicy": {
    "defaultIndependent": [
      "c-clang",
      "rust"
    ],
    "exception": "Record why one independent baseline is sufficient when two baselines are not reasonable.",
    "gameRole": "exploratory-never-authority"
  },
  "tasks": [
    {
      "id": "protocol",
      "label": "protocol",
      "status": "completed",
      "implementation": "complete",
      "dependencies": [],
      "outputs": [
        "WBench/1 schema",
        "language profiles and lanes",
        "correctness-before-samples rule"
      ],
      "adversarialCases": [
        "BMD1-W-1487-profile-missing",
        "BMD1-W-1487-profile-duplicate",
        "BMD1-W-1487-idiomatic-not-primary",
        "BMD1-W-1487-oracle-partial",
        "BMD1-W-1487-equivalent-semantic-difference",
        "BMD1-W-1487-learner-artificially-slow",
        "BMD1-W-1487-frontier-missing-disclosure",
        "BMD1-W-1487-best-only",
        "BMD1-W-1487-output-constant-bypass",
        "BMD1-W-1487-specialization-universal",
        "BMD1-W-1487-invalid-benchmark-disposition",
        "BMD1-W-1487-deferred",
        "BMD1-W-1487-not-applicable",
        "BMD1-W-1487-deferred-missing-blocker",
        "BMD1-W-1487-not-applicable-missing-reason"
      ],
      "stopCondition": "WBench/1 fields, profiles, lanes and correctness rules are validated without language results."
    },
    {
      "id": "seed-compiler-lifecycle",
      "label": "seed compiler lifecycle matrix",
      "status": "ready",
      "implementation": "partial",
      "dependencies": [
        "protocol"
      ],
      "outputs": [
        "3x9 compiler lifecycle matrix",
        "source-backed ready point",
        "result validator"
      ],
      "adversarialCases": [
        "BMD1-W-1488-current-matrix",
        "BMD1-W-1488-flattened-axis",
        "BMD1-W-1488-no-op-without-cache",
        "BMD1-W-1488-edit-without-cache",
        "BMD1-W-1488-internal-stage-without-instrumentation",
        "BMD1-W-1488-runtime-mixed",
        "BMD1-W-1488-result-blocked-point",
        "BMD1-W-1488-result-language-without-backend",
        "BMD1-W-1488-result-regression-without-comparison",
        "BMD1-W-1488-result-partial-oracle",
        "BMD1-W-1488-result-tracked-timing",
        "BMD1-W-1488-result-output-overwrite",
        "BMD1-W-1488-result-oracle-false",
        "BMD1-W-1488-result-forged-metric",
        "BMD1-W-1488-result-even-samples",
        "BMD1-W-1488-result-leading-zero",
        "BMD1-W-1488-result-u64-overflow",

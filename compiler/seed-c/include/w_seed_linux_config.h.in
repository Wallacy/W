#define W_SEED_LINUX_MLIR_TRANSLATE_PATH "@W_SEED_LINUX_MLIR_TRANSLATE_HEADER_PATH@"
#define W_SEED_LINUX_LLVM_CONFIG_PATH "@W_SEED_LINUX_LLVM_CONFIG_HEADER_PATH@"
#define W_SEED_LINUX_LLC_PATH "@W_SEED_LINUX_LLC_HEADER_PATH@"
#define W_SEED_LINUX_LINK_DRIVER_PATH "@W_SEED_LINUX_LINK_DRIVER_HEADER_PATH@"

#endif

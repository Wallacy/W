{
  "name": "w-language-project",
  "version": "0.0.0",
  "private": true,
  "description": "Design and executable specification workspace for the W language",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "tooling:install": "bun ci --cwd tooling/tree-sitter-w",
    "check": "bun run --cwd tooling/tree-sitter-w check",
    "check:abi": "bun tooling/check-layout-abi-cases.mjs",
    "check:allocation": "bun test tooling/allocation-reference.test.mjs && bun tooling/check-allocation-cases.mjs",
    "check:allocator-scope": "bun test tooling/allocator-scope-reference.test.mjs && bun tooling/check-allocator-scope-cases.mjs",
    "check:boundary": "bun tooling/check-boundary-effect-cases.mjs",
    "check:syntax-atlas": "bun test tooling/syntax-atlas.test.mjs && bun tooling/syntax-atlas.mjs --check",
    "check:service-recovery": "bun test tooling/service-recovery-reference.test.mjs && bun tooling/check-service-recovery-cases.mjs",
    "check:docs": "bun run --cwd tooling/tree-sitter-w check:docs",
    "check:borrow-expressivity": "bun test tooling/borrow-expressivity-reference.test.mjs && bun tooling/check-borrow-expressivity-cases.mjs && bun test tooling/studies/r1-borrow-expressivity/oracle.test.mjs && bun run --cwd tooling/tree-sitter-w parse:borrow-expressivity",
    "check:brx2": "bun test tooling/brx2-borrow-relations-reference.test.mjs tooling/studies/brx2-borrow-relations/oracle.test.mjs && bun tooling/check-brx2-borrow-relations.mjs",
    "check:frontend-freeze": "bun test tooling/frontend-freeze-guards.test.mjs && bun tooling/check-frontend-freeze.mjs",
    "check:semantic-matrix": "bun tooling/check-semantic-diagnostic-matrix.mjs && bun test tooling/semantic-diagnostic-matrix-reference.test.mjs",
    "check:execution": "bun tooling/check-execution-concurrency-cases.mjs",
    "check:execution-ergonomics": "bun test tooling/execution-ergonomics-reference.test.mjs && bun tooling/check-execution-ergonomics-cases.mjs",
    "check:process-root": "bun test tooling/process-root-reference.test.mjs && bun tooling/check-process-root-cases.mjs",
    "check:filesystem": "bun test tooling/filesystem-reference.test.mjs && bun tooling/check-filesystem-cases.mjs",
    "check:io-error": "bun test tooling/io-error-reference.test.mjs && bun tooling/check-io-error-cases.mjs",
    "check:time": "bun test tooling/operational-time-reference.test.mjs && bun tooling/check-operational-time-cases.mjs",
    "check:source-calls": "bun tooling/check-source-call-shapes.mjs",
    "check:web-bodies": "bun test tooling/web-body-reference.test.mjs && bun tooling/check-web-body-cases.mjs",
    "check:foreign-bodies": "bun test tooling/foreign-body-reference.test.mjs && bun tooling/check-foreign-body-cases.mjs",
    "check:ownership-execution": "bun test tooling/ownership-execution-reference.test.mjs && bun tooling/check-ownership-execution-cases.mjs",
    "check:channel": "bun test tooling/channel-reference.test.mjs && bun tooling/check-channel-cases.mjs",
    "check:context-local": "bun test tooling/context-local-reference.test.mjs && bun tooling/check-context-local-cases.mjs",
    "check:interference-layout": "bun test tooling/interference-layout-reference.test.mjs && bun tooling/check-interference-layout-cases.mjs",
    "check:liveness": "bun test tooling/runtime-liveness-reference.test.mjs && bun tooling/check-runtime-liveness-cases.mjs",
    "check:lazy": "bun test tooling/lazy-behavior-reference.test.mjs && bun tooling/check-lazy-behavior-cases.mjs",
    "check:locks": "bun test tooling/scoped-lock-reference.test.mjs && bun tooling/check-scoped-lock-cases.mjs",
    "check:links": "bun tooling/check-markdown-links.mjs",
    "check:memory": "bun tooling/check-memory-transition-cases.mjs",
    "check:shared-control": "bun test tooling/shared-control-reference.test.mjs && bun tooling/check-shared-control-cases.mjs",
    "check:packages": "bun tooling/check-package-release-cases.mjs",
    "check:pkg1": "bun test tooling/pkg1-project-transaction-reference.test.mjs tooling/studies/pkg1-project-transaction/oracle.test.mjs && bun tooling/check-pkg1-project-transaction.mjs",
    "check:std": "bun tooling/check-std-api-contracts.mjs",
    "check:script-workflow": "bun test tooling/script-workflow-reference.test.mjs && bun tooling/check-script-workflow-cases.mjs",
    "check:snapshot-cell": "bun test tooling/snapshot-cell-reference.test.mjs && bun tooling/check-snapshot-cell-cases.mjs",
    "check:repl-session": "bun test tooling/repl-session-reference.test.mjs && bun tooling/check-repl-session-cases.mjs",
    "check:presentation": "bun test tooling/presentation-reference.test.mjs && bun tooling/check-presentation-cases.mjs",
    "check:jupyter": "bun test tooling/jupyter-reference.test.mjs && bun tooling/check-jupyter-cases.mjs",
    "check:notebook-export": "bun test tooling/notebook-export-reference.test.mjs && bun tooling/check-notebook-export-cases.mjs",
    "check:dlpack": "bun test tooling/dlpack-reference.test.mjs && bun tooling/check-dlpack-cases.mjs",
    "check:device-execution": "bun test tooling/device-execution-reference.test.mjs && bun tooling/check-device-execution-cases.mjs",
    "check:kernel-modules": "bun test tooling/kernel-module-reference.test.mjs && bun tooling/check-kernel-module-cases.mjs",
    "check:substitutions": "bun tooling/check-substitution-cases.mjs --require-complete",
    "check:substitution-surface": "bun tooling/substitution-surface.mjs",
    "check:tabular-carrier": "bun test tooling/tabular-carrier-reference.test.mjs && bun tooling/check-tabular-carrier-cases.mjs",
    "check:tabular-adapters": "bun test tooling/tabular-adapter-reference.test.mjs && bun tooling/check-tabular-adapter-cases.mjs",
    "check:studies": "bun tooling/check-study-bundles.mjs && bun run check:gen1 && bun run check:syn1 && bun run check:brx2 && bun run check:cyc1 && bun run check:dyn1 && bun run check:pkg1 && bun test tooling/studies && bun run --cwd tooling/tree-sitter-w parse:studies",
    "check:hum0": "bun test tooling/hum0-human-review-reference.test.mjs tooling/studies/hum0-human-review/oracle.test.mjs && bun tooling/check-hum0-human-review.mjs",
    "check:cyc1": "bun test tooling/cyc1-explicit-cycle-reference.test.mjs tooling/studies/cyc1-explicit-cycle-lifecycle/oracle.test.mjs && bun tooling/check-cyc1-explicit-cycle.mjs && bun run --cwd tooling/tree-sitter-w parse:cyc1",
    "check:gen1": "bun test tooling/gen1-incremental-suspension-reference.test.mjs && bun tooling/check-gen1-incremental-suspension.mjs",
    "check:capability-matrix": "bun tooling/check-capability-matrix.mjs && bun test tooling/capability-matrix-reference.test.mjs",
    "check:atom1": "bun test tooling/studies/atom1-atomic-extensibility/oracle.test.mjs && bun tooling/check-atom1-atomic-extensibility.mjs",
    "check:ipc1": "bun test tooling/ipc1-mapped-ipc-reference.test.mjs && bun test tooling/studies/ipc1-mapped-ipc/oracle.test.mjs && bun tooling/check-ipc1-mapped-ipc.mjs",
    "check:syn1": "bun test tooling/syn1-typed-generation-reference.test.mjs tooling/studies/syn1-typed-generation/oracle.test.mjs && bun tooling/check-syn1-typed-generation.mjs",
    "check:syn1-typed-generation": "bun test tooling/syn1-typed-generation-reference.test.mjs tooling/studies/syn1-typed-generation/oracle.test.mjs && bun tooling/check-syn1-typed-generation.mjs",
    "check:dyn1": "bun test tooling/dyn1-versioned-behavior-reference.test.mjs tooling/studies/dyn1-versioned-behavior/oracle.test.mjs && bun tooling/check-dyn1-versioned-behavior.mjs",
    "check:wmeta": "bun run --cwd tooling/tree-sitter-w check:wmeta",
    "measure:substitutions": "bun tooling/substitution-surface.mjs --write",
    "measure:std": "bun tooling/check-std-api-contracts.mjs --write",
    "design:index": "bun tooling/design-index.mjs --write",
    "design:index:check": "bun tooling/design-index.mjs --check"
  }
}

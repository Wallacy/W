    "parse:asic0": "bun run --cwd tooling/tree-sitter-w parse:asic0",
    "check:studies": "bun tooling/check-study-bundles.mjs && bun run check:r1c0 && bun run check:prc0 && bun run check:asic0 && bun run check:frc0 && bun run check:gen1 && bun run check:gen2 && bun run check:syn1 && bun run check:brx2 && bun run check:brx3 && bun run check:cyc1 && bun run check:cyc2 && bun run check:dyn1 && bun run check:hrd0 && bun run check:syn2-dyn2 && bun run check:pkg1 && bun run check:avf0 && bun run check:sec0 && bun run check:atom2 && bun run check:ipc1 && bun test tooling/studies && bun run --cwd tooling/tree-sitter-w parse:studies",

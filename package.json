    "check:seed-source-reader": "bun tooling/check-seed-source-reader.mjs",
    "check:seed-lexer": "bun tooling/check-seed-lexer.mjs",
    "check:seed-parser": "bun tooling/check-seed-parser.mjs",
    "check:seed-unicode": "bun tooling/check-seed-unicode.mjs",
